{
  "name": "offline-tiles",
  "version": "1.0.0",
  "description": "Cloudflare Worker that range-serves XYZ vector tiles from a Protomaps planet .pmtiles archive on R2.",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "../worker-cloud-prod/deployProduction.sh",
    "deploy:dev": "../worker-cloud-dev/deployDev.sh",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "./setupLocalTiles.sh && wrangler dev --local"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.97.0"
  }
}
